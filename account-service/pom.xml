<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ─────────────────────────────────────────────────────────────
         Inherit version management from the parent POM.
         This gives us Spring Boot 3.2.3, Spring Cloud 2023.0.1,
         and Java 21 without redeclaring them here.
         relativePath tells Maven to look one directory up rather
         than searching the local .m2 repository cache first.
         ───────────────────────────────────────────────────────────── -->
    <parent>
        <groupId>com.hdfc</groupId>
        <artifactId>hdfc-netbanking</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>account-service</artifactId>
    <name>Account Service</name>
    <description>
        Account creation, balance management, and multi-account type support
        (Savings, Current, Fixed Deposit) for HDFC NetBanking.
    </description>

    <dependencies>

        <!-- ─────────────────────────────────────────────────────────
             SPRING BOOT WEB
             Embeds Tomcat and enables REST controllers over HTTP.
             Without this the service has no HTTP server and cannot
             receive any requests from the API Gateway.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             SPRING DATA JPA
             ORM layer — maps Java entities to MySQL 8 tables via
             Hibernate. Provides repositories, @Transactional support,
             and the JPQL/Criteria query API.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────────
     HIBERNATE ENVERS
     Provides @Audited for automatic entity revision tracking.
     When Audit Service (Phase 4) is activated, Envers creates
     an accounts_AUD table and writes a revision row on every
     insert, update, and delete — giving us immutable audit logs
     without any manual logging code.
     We add this now so the Account entity is Envers-ready.
     The revision tables are created automatically by Hibernate
     when ddl-auto=update during development.
     ───────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-envers</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             MYSQL DRIVER
             JDBC driver that Hibernate uses to communicate with
             MySQL 8 at runtime. runtime scope because our Java code
             never imports this directly — Hibernate loads it via the
             JDBC SPI mechanism.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             SPRING DATA REDIS
             Provides RedisTemplate and Spring Cache integration.
             Account Service uses a Write-Through caching strategy
             for account balances: every balance update writes to
             both Redis and MySQL simultaneously.
             Cache key pattern : account:balance:{accountId}
             TTL               : 30 seconds
             Without this, every balance read hits MySQL directly
             and there is no protection against thundering-herd load.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             SPRING SECURITY
             Provides the JWT filter chain, SecurityConfig, and
             @PreAuthorize support. Account Service validates JWTs
             issued by User Service — it never issues tokens itself.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             JJWT 0.12.6  (must match User Service version exactly)
             jjwt-api     — core interfaces and builders (compile)
             jjwt-impl    — runtime implementation (runtime only)
             jjwt-jackson — JSON serialisation of JWT claims (runtime)
             All three artifacts are always required together.
             JJWT deliberately splits the API from the implementation
             so that compile-time code never depends on internals.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             EUREKA CLIENT
             Registers this service as "account-service" with the
             Eureka Server at port 8761. Enables load-balanced calls
             from Transaction Service using lb://account-service and
             allows the API Gateway to route traffic here by name.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             SPRING WEBFLUX  (for WebClient only)
             WebClient is the modern non-blocking HTTP client.
             Account Service uses it to call User Service when
             validating that a userId exists before opening an account.
             Adding WebFlux alongside spring-boot-starter-web is
             valid — Spring Boot runs both on the same Tomcat container.
             We are NOT building a reactive application.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             VALIDATION
             Activates Bean Validation (Jakarta) so that @Valid,
             @NotNull, @NotBlank, @DecimalMin etc. on request DTOs
             are enforced at the controller boundary.
             Without this starter, validation annotations are present
             in the code but silently never executed.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             ACTUATOR
             Exposes /actuator/health and /actuator/info.
             Eureka requires a reachable health endpoint to mark this
             service as UP. The API Gateway also uses it for liveness
             probes. Without this, Eureka marks the service as DOWN
             even if it is running correctly.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             LOMBOK
             Compile-time annotation processor that eliminates
             boilerplate: @Getter, @Setter, @Builder,
             @RequiredArgsConstructor, @Slf4j etc.
             optional=true means modules that depend on account-service
             do not accidentally inherit Lombok on their classpath.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────
             TESTING
             spring-boot-starter-test bundles JUnit 5, Mockito,
             AssertJ, and MockMvc — everything needed for unit tests
             and @WebMvcTest slice tests.
             spring-security-test provides @WithMockUser and
             SecurityMockMvcRequestPostProcessors for testing
             endpoints that require an authenticated principal.
             Both are test scope — never packaged into the final JAR.
             ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <!-- ─────────────────────────────────────────────────────
                 SPRING BOOT MAVEN PLUGIN
                 Repackages the compiled classes into a single
                 executable fat JAR containing all dependencies.
                 The <excludes> block strips Lombok from the final JAR.
                 Lombok is a compile-only tool — its annotations are
                 processed and replaced with real code at compile time.
                 Keeping it in the runtime classpath wastes space and
                 could cause conflicts.
                 ───────────────────────────────────────────────────── -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>