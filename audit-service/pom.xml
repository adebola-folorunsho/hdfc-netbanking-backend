<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ─────────────────────────────────────────────────────────────────
         Inherit version management from the parent POM.
         Gives us Spring Boot 3.2.3, Spring Cloud 2023.0.1, Java 21.
         ───────────────────────────────────────────────────────────────── -->
    <parent>
        <groupId>com.hdfc</groupId>
        <artifactId>hdfc-netbanking</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>audit-service</artifactId>
    <name>Audit Service</name>
    <description>
        System-wide audit log service. Consumes TRANSACTION_CREATED and
        FRAUD_ALERT Kafka events from Transaction Service and persists
        immutable, append-only AuditLog records to hdfc_audit_db.
        Exposes admin-only query endpoints via Admin Gateway.
    </description>

    <dependencies>

        <!-- ─────────────────────────────────────────────────────────────
             SPRING BOOT WEB
             Embeds Tomcat and enables REST controllers over HTTP.
             Exposes /api/v1/admin/audit/** endpoints routed through
             Admin Gateway (port 8090).
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────
             SPRING DATA JPA
             ORM layer — maps AuditLog entity to MySQL 8 via Hibernate.
             Provides repositories and @Transactional support.
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────
             MYSQL DRIVER
             JDBC driver loaded by Hibernate at runtime via JDBC SPI.
             runtime scope — never imported directly in Java code.
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────
             SPRING KAFKA
             Audit Service is a Kafka consumer only.
             Consumes from transaction-events topic:
               - TRANSACTION_CREATED events → AuditLog entry
               - FRAUD_ALERT events → AuditLog entry with FRAUD type
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────
             EUREKA CLIENT
             Registers as "audit-service" with Eureka Server (8761).
             Admin Gateway discovers this service via Eureka for
             routing /api/v1/admin/audit/** requests.
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────
             ACTUATOR
             Exposes /actuator/health for Eureka health checks.
             Without this, Eureka marks the service as OUT_OF_SERVICE.
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────
             VALIDATION
             Activates @Valid, @NotNull etc. on request DTOs.
             Without this starter, Bean Validation annotations are
             silently ignored at runtime.
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────
             LOMBOK
             Compile-time annotation processor for boilerplate reduction.
             optional=true prevents transitive dependency leakage.
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>springboot3-dotenv</artifactId>
        </dependency>

        <!-- ─────────────────────────────────────────────────────────────
             TESTING
             spring-boot-starter-test: JUnit 5, Mockito, AssertJ for
             unit and slice tests.
             spring-kafka-test: EmbeddedKafkaBroker for Kafka consumer
             tests without a real Kafka instance.
             ───────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- ─────────────────────────────────────────────────────────
                 SPRING BOOT MAVEN PLUGIN
                 Packages as executable fat JAR for Railway deployment.
                 Lombok excluded from final JAR — compile-only tool.
                 ───────────────────────────────────────────────────────── -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>