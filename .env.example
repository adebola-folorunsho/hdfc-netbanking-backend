# =============================================================================
# HDFC NetBanking — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git — it is in .gitignore.
# =============================================================================

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_USERNAME=
MYSQL_PASSWORD=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32 characters) for HS256 signing.
# Must be identical across all services that validate JWT tokens:
# User Service, Account Service, Transaction Service, Admin Gateway.
JWT_SECRET=

# ─── Paystack ────────────────────────────────────────────────────────────────
# Obtain from https://dashboard.paystack.com/#/settings/developers
# Sandbox keys start with sk_test_ — never use live keys locally.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ─── Gmail SMTP ──────────────────────────────────────────────────────────────
# Gmail address used to send notification emails.
# App Password — generate at Google Account → Security → App Passwords.
# Do NOT use your Gmail account password here.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# ─── ExchangeRate API ────────────────────────────────────────────────────────
# Obtain a free API key from https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=